{
  "compilerOptions": {
    "target": "ES2022",                   // TypeScript cible moderne
    "module": "ESNext",                   // ESModules pour Node/TSX
    "moduleResolution": "node",           // résout les imports comme Node
    "strict": true,                       // toutes les vérifications strictes
    "esModuleInterop": true,              // compatibilité import/export
    "isolatedModules": true,              // nécessaire pour TSX/tsx
    "verbatimModuleSyntax": true,         // garde la syntaxe import/export
    "noUncheckedIndexedAccess": true,     // stricter TS
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,                 // ignore les fichiers de types tiers
    "noUncheckedSideEffectImports": true,
    "types": ["node"],                    // types Node disponibles
    "sourceMap": true                     // si tu veux debugger TS dans VSCode
  },
  "include": ["src"],                     // inclut ton dossier source
  "exclude": ["node_modules"]             // exclut node_modules
}
